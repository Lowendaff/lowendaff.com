---
import { render, type CollectionEntry } from 'astro:content';
import { getPublishedPosts } from '../../lib/posts';
import ReviewLayout from '../../layouts/ReviewLayout.astro';
import FullReview from '../../components/archive/FullReview.astro';
export async function getStaticPaths() {
  return (await getPublishedPosts()).map((post) => ({
    params: { id: post.data.permalink!.split('/')[2] },
    props: { post },
  }));
}
interface Props {
  post: CollectionEntry<'posts'>;
}
const { post } = Astro.props;
const readable = post.data.format === 'review-markdown';
const rendered = readable ? undefined : await render(post);
const Content = rendered?.Content;
const headings = rendered?.headings ?? [];
---

<ReviewLayout post={post} headings={headings}>
  {readable && post.data.review ? (
    <FullReview review={post.data.review} />
  ) : post.data.review ? (
    Content && <Content />
  ) : (
    <div class="prose">{Content && <Content />}</div>
  )}
</ReviewLayout>
