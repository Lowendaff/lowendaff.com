---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import Flag from '../components/Flag.astro';
import TelegramLogo from '../components/TelegramLogo.astro';
import RecordList from '../components/RecordList.astro';
import { getRecords } from '../lib/records';
import {
  isExoticPost,
  EXOTIC_TERRITORIES,
  EXOTIC_ZONES,
  EXOTIC_SPECIAL_EPISODES,
  type ExoticFilterId,
} from '../lib/exotic';
import { serializeJsonLd } from '../lib/seo';
import '../styles/exotic.css';

const allPosts = (await getCollection('posts')).filter(
  ({ data }) => !data.draft,
);
const exoticPosts = allPosts.filter(isExoticPost);
const exoticRecords = getRecords(exoticPosts);

const countByCode = new Map<string, number>();
for (const post of exoticPosts) {
  const code = post.data.country;
  if (code) countByCode.set(code, (countByCode.get(code) || 0) + 1);
}

const latestRecordByCode = new Map<
  string,
  { href: string; title: string; vendor: string }
>();
for (const rec of exoticRecords) {
  if (rec.country && !latestRecordByCode.has(rec.country)) {
    latestRecordByCode.set(rec.country, {
      href: rec.href,
      title: rec.title,
      vendor: rec.merchant,
    });
  }
}

/** Float unlocked stamps to the front while preserving chronological episode order. */
const territories = [...EXOTIC_TERRITORIES].sort(
  (a, b) =>
    Number((countByCode.get(b.code) || 0) > 0) -
    Number((countByCode.get(a.code) || 0) > 0),
);

const countByFilter = new Map<ExoticFilterId, number>();
countByFilter.set('all', territories.length);
countByFilter.set(
  'unlocked',
  territories.filter((t) => (countByCode.get(t.code) || 0) > 0).length,
);
countByFilter.set('tier-t1', territories.filter((t) => t.tier === 'T1').length);
for (const item of territories) {
  countByFilter.set(item.zone, (countByFilter.get(item.zone) || 0) + 1);
}

const initial = territories[0];
const initialCount = countByCode.get(initial.code) || 0;
const initialRecord = latestRecordByCode.get(initial.code);
---

<BaseLayout
  title="奇葩小国"
  active="exotic"
  description={`对照小约翰可汗《奇葩小国》第 01–53 期合集，收录全球 ${EXOTIC_TERRITORIES.length} 处冷门国家与地区的海底光缆、绕行路由与 VPS / 独立服务器实测图鉴。`}
  breadcrumbs={[
    { name: '首页', path: '/' },
    { name: '奇葩小国', path: '/exotic/' },
  ]}
>
  <div class="shell exotic-page home-revision" data-exotic-page>
    <header class="exotic-hero">
      <div class="exotic-hero-main">
        <span class="badge-pill">
          <Icon name="planet-line" size={14} />
          <span>通辽宇宙集邮册 · 冷门海缆 · 稀有自治域实测</span>
        </span>
        <h1>奇葩小国</h1>
        <p>
          以小约翰可汗《奇葩小国》第 01–53
          期合集为蓝本，跳出美西与港日新的常规航线，横跨四大分区梳理
          {EXOTIC_TERRITORIES.length}
          处国家与地区的海底光缆、跨洲路由与真实机房测试手记。
        </p>
      </div>
      <dl class="exotic-stats" aria-label="探索进度">
        <div>
          <dt>已点亮奇葩档案</dt>
          <dd class="mono">{exoticRecords.length} 篇</dd>
        </div>
        <div>
          <dt>合集国家图鉴</dt>
          <dd class="mono">{EXOTIC_TERRITORIES.length} 处</dd>
        </div>
      </dl>
    </header>

    <section class="exotic-studio panel" aria-labelledby="exotic-studio-title">
      <div class="exotic-studio-header">
        <div>
          <h2 id="exotic-studio-title">
            <Icon name="compass-3-line" size={18} />
            <span>奇葩小国集邮册与盲盒罗盘</span>
          </h2>
          <p>
            已点亮实测国家自动置顶；可按分区或购买难度筛选{' '}
            {EXOTIC_TERRITORIES.length}
            枚节点邮票，直达对应期数 B 站视频与本站实测报告。
          </p>
        </div>
        <button
          type="button"
          class="button primary exotic-spin-btn"
          data-exotic-spin
        >
          <Icon name="magic-2-line" size={16} />
          <span>随机抽一个奇葩小国</span>
        </button>
      </div>

      <div
        class="exotic-zone-tabs notion-view-tabs"
        role="tablist"
        aria-label="奇葩小国筛选视图"
      >
        {EXOTIC_ZONES.map((z, idx) => (
          <button
            type="button"
            role="tab"
            data-exotic-zone={z.id}
            aria-selected={idx === 0 ? 'true' : 'false'}
          >
            <span>{z.label}</span>
            <span
              class:list={[
                'exotic-zone-count',
                'mono',
                z.id === 'unlocked' &&
                  (countByFilter.get('unlocked') || 0) > 0 &&
                  'is-unlocked',
              ]}
            >
              {countByFilter.get(z.id) || 0}
            </span>
          </button>
        ))}
      </div>

      <div class="exotic-studio-grid">
        <article class="exotic-spotlight" aria-live="polite" data-exotic-card>
          <div class="exotic-spotlight-top">
            <div class="exotic-spotlight-place">
              <span class="exotic-flag-slot" data-exotic-flag>
                <Flag code={initial.code} size={24} />
              </span>
              <div>
                <h3 data-exotic-title>
                  {initial.name} · {initial.city}
                </h3>
                <span class="exotic-code mono" data-exotic-code>
                  ISO {initial.code} · 奇葩小国 {initial.epBadge} ·{' '}
                  {initial.tag}
                </span>
              </div>
            </div>
            <span
              class="exotic-rarity-pill"
              data-tier={initial.tier}
              data-exotic-rarity
            >
              {initial.rarity}
            </span>
          </div>

          <dl class="exotic-meta-strip">
            <div>
              <dt>
                <Icon name="route-line" size={14} /> 出境海缆 / 链路
              </dt>
              <dd data-exotic-cable>{initial.cable}</dd>
            </div>
            <div>
              <dt>
                <Icon name="time-line" size={14} /> 国内往返参考延迟
              </dt>
              <dd class="mono" data-exotic-rtt>
                {initial.rttHint}
              </dd>
            </div>
          </dl>

          <p class="exotic-trivia" data-exotic-note>
            {initial.note}
          </p>

          <div class="exotic-episodes" data-exotic-episodes>
            {initial.episodes.map((ep) => (
              <a
                class="exotic-ep-link"
                href={`https://www.bilibili.com/video/${ep.bvid}/`}
                target="_blank"
                rel="noopener noreferrer"
              >
                <Icon name="bilibili-line" size={15} />
                <span class="mono exotic-ep-num">【奇葩小国{ep.ep}】</span>
                <span class="exotic-ep-title">{ep.title}</span>
                <Icon name="arrow-right-up-line" size={13} />
              </a>
            ))}
          </div>

          <div class="exotic-spotlight-footer">
            <span class="exotic-status-slot" data-exotic-status>
              {initialCount > 0 && initialRecord ? (
                <a class="exotic-unlocked-link" href={initialRecord.href}>
                  <Icon name="check-circle-line" size={15} />
                  <span>
                    已点亮 {initialCount} 篇实测 · 查看 {initialRecord.vendor}{' '}
                    测评
                  </span>
                </a>
              ) : (
                <span class="subtle-label">
                  暂未收录实测样机 · 持续蹲守库存中
                </span>
              )}
            </span>
            <a
              class="exotic-nominate-link"
              href="https://t.me/lowendaff_blog"
              target="_blank"
              rel="noopener noreferrer"
            >
              <TelegramLogo size={15} />
              <span>提供冷门商家线索</span>
              <Icon name="arrow-right-up-line" size={14} />
            </a>
          </div>
        </article>

        <div
          class="exotic-stamp-grid"
          role="listbox"
          aria-label="奇葩小国集邮册"
        >
          {territories.map((item, idx) => {
            const count = countByCode.get(item.code) || 0;
            return (
              <button
                type="button"
                role="option"
                class:list={['exotic-stamp', count > 0 && 'has-posts']}
                data-exotic-stamp={idx}
                data-stamp-zone={item.zone}
                data-stamp-tier={item.tier}
                data-stamp-unlocked={count > 0 ? 'true' : 'false'}
                aria-selected={idx === 0 ? 'true' : 'false'}
              >
                <div class="exotic-stamp-top">
                  <Flag code={item.code} size={16} />
                  <span class="mono exotic-stamp-iso">
                    {item.code} · {item.epBadge}
                  </span>
                  <span
                    class:list={[
                      'exotic-stamp-badge',
                      count > 0 && 'is-unlocked',
                    ]}
                    data-badge-tier={count > 0 ? undefined : item.tier}
                  >
                    {count > 0 ? `${count} 篇` : item.tier}
                  </span>
                </div>
                <strong>{item.name}</strong>
                <small>{item.tag}</small>
                <span class="exotic-stamp-flag-tpl" hidden>
                  <Flag code={item.code} size={24} />
                </span>
              </button>
            );
          })}
        </div>
      </div>

      <p class="exotic-special-note">
        <span>
          合集番外说明：无独立 ISO 代码与 RIR
          自治域（ASN）的两期特辑未计入邮票总数——
        </span>
        {EXOTIC_SPECIAL_EPISODES.map((sp, i) => (
          <>
            {i > 0 && <span> · </span>}
            <a
              href={`https://www.bilibili.com/video/${sp.bvid}/`}
              target="_blank"
              rel="noopener noreferrer"
            >
              【奇葩小国{sp.ep}】{sp.title}
            </a>
          </>
        ))}
      </p>
    </section>

    <template data-exotic-icons-tpl>
      <span data-icon-bili>
        <Icon name="bilibili-line" size={15} />
      </span>
      <span data-icon-ext>
        <Icon name="arrow-right-up-line" size={13} />
      </span>
      <span data-icon-check>
        <Icon name="check-circle-line" size={15} />
      </span>
    </template>

    {exoticRecords.length > 0 ? (
      <RecordList records={exoticRecords} />
    ) : (
      <section class="exotic-empty-vault panel" aria-labelledby="vault-title">
        <div class="exotic-empty-icon">
          <Icon name="compass-line" size={24} />
        </div>
        <h2 id="vault-title">探险档案柜正在等待第一台冷门小鸡</h2>
        <p>
          凡属于主流枢纽以外的冷门国家/地区，或在文章 Frontmatter 中标记为
          <code>奇葩小国</code>、<code>冷门线路</code>
          的实测记录，发布后都会自动归档至此并点亮对应国家邮票。
        </p>
        <div class="exotic-empty-actions">
          <a class="button secondary" href="/">
            <Icon name="book-2-line" size={16} />
            查看现有全部测评
          </a>
          <a class="button secondary" href="/map/">
            <Icon name="earth-2-line" size={16} />
            打开 3D 测评地图
          </a>
        </div>
      </section>
    )}

    <script
      type="application/json"
      data-exotic-data
      set:html={serializeJsonLd(
        territories.map((t) => {
          const rec = latestRecordByCode.get(t.code);
          return {
            ...t,
            count: countByCode.get(t.code) || 0,
            latestHref: rec?.href || '',
            latestVendor: rec?.vendor || '',
          };
        }),
      )}
    />
  </div>
</BaseLayout>
<script>
  const root = document.querySelector<HTMLElement>('[data-exotic-page]');
  if (root) {
    const data = JSON.parse(
      root.querySelector('[data-exotic-data]')?.textContent || '[]',
    ) as Array<{
      code: string;
      zone: string;
      tier: string;
      epBadge: string;
      name: string;
      city: string;
      tag: string;
      rarity: string;
      rttHint: string;
      cable: string;
      note: string;
      episodes: Array<{ ep: string; bvid: string; title: string }>;
      count: number;
      latestHref: string;
      latestVendor: string;
    }>;
    const stamps = Array.from(
      root.querySelectorAll<HTMLButtonElement>('[data-exotic-stamp]'),
    );
    const zoneTabs = Array.from(
      root.querySelectorAll<HTMLButtonElement>('[data-exotic-zone]'),
    );
    const spinBtn = root.querySelector<HTMLButtonElement>('[data-exotic-spin]');
    const flagSlot = root.querySelector<HTMLElement>('[data-exotic-flag]');
    const titleEl = root.querySelector<HTMLElement>('[data-exotic-title]');
    const codeEl = root.querySelector<HTMLElement>('[data-exotic-code]');
    const rarityEl = root.querySelector<HTMLElement>('[data-exotic-rarity]');
    const cableEl = root.querySelector<HTMLElement>('[data-exotic-cable]');
    const rttEl = root.querySelector<HTMLElement>('[data-exotic-rtt]');
    const noteEl = root.querySelector<HTMLElement>('[data-exotic-note]');
    const episodesEl = root.querySelector<HTMLElement>(
      '[data-exotic-episodes]',
    );
    const statusEl = root.querySelector<HTMLElement>('[data-exotic-status]');
    const iconTpl = root.querySelector<HTMLTemplateElement>(
      '[data-exotic-icons-tpl]',
    );

    const cloneIcon = (sel: string) => {
      const svg = iconTpl?.content.querySelector(`${sel} svg`);
      return svg ? (svg.cloneNode(true) as SVGElement) : null;
    };

    let current = 0;
    let activeZone = 'all';
    let spinning = false;

    const matchesFilter = (item: (typeof data)[number], filter: string) => {
      if (filter === 'all') return true;
      if (filter === 'unlocked') return item.count > 0;
      if (filter === 'tier-t1') return item.tier === 'T1';
      return item.zone === filter;
    };

    const getVisibleIndices = () =>
      data
        .map((item, idx) => (matchesFilter(item, activeZone) ? idx : -1))
        .filter((idx) => idx >= 0);

    const applyZoneFilter = (filter: string) => {
      activeZone = filter;
      zoneTabs.forEach((t) =>
        t.setAttribute(
          'aria-selected',
          String(t.dataset.exoticZone === filter),
        ),
      );
      stamps.forEach((btn, idx) => {
        const item = data[idx];
        btn.hidden = item ? !matchesFilter(item, filter) : true;
      });
    };

    const selectTerritory = (index: number, scrollStamp = false) => {
      const item = data[index];
      if (!item) return;
      current = index;
      stamps.forEach((btn, i) => {
        btn.setAttribute('aria-selected', String(i === index));
      });
      if (scrollStamp) {
        stamps[index]?.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
      }
      const tpl = stamps[index]?.querySelector('.exotic-stamp-flag-tpl');
      if (flagSlot && tpl) flagSlot.innerHTML = tpl.innerHTML;
      if (titleEl) titleEl.textContent = `${item.name} · ${item.city}`;
      if (codeEl) {
        codeEl.textContent = `ISO ${item.code} · 奇葩小国 ${item.epBadge} · ${item.tag}`;
      }
      if (rarityEl) {
        rarityEl.dataset.tier = item.tier;
        rarityEl.textContent = item.rarity;
      }
      if (cableEl) cableEl.textContent = item.cable;
      if (rttEl) rttEl.textContent = item.rttHint;
      if (noteEl) noteEl.textContent = item.note;

      if (episodesEl) {
        const links = item.episodes.map((ep) => {
          const a = document.createElement('a');
          a.className = 'exotic-ep-link';
          a.href = `https://www.bilibili.com/video/${encodeURIComponent(ep.bvid)}/`;
          a.target = '_blank';
          a.rel = 'noopener noreferrer';
          const biliSvg = cloneIcon('[data-icon-bili]');
          if (biliSvg) a.append(biliSvg);
          const num = document.createElement('span');
          num.className = 'mono exotic-ep-num';
          num.textContent = `【奇葩小国${ep.ep}】`;
          const title = document.createElement('span');
          title.className = 'exotic-ep-title';
          title.textContent = ep.title;
          a.append(num, title);
          const extSvg = cloneIcon('[data-icon-ext]');
          if (extSvg) a.append(extSvg);
          return a;
        });
        episodesEl.replaceChildren(...links);
      }

      if (statusEl) {
        if (item.count > 0 && item.latestHref) {
          const a = document.createElement('a');
          a.className = 'exotic-unlocked-link';
          a.href = item.latestHref;
          const checkSvg = cloneIcon('[data-icon-check]');
          if (checkSvg) a.append(checkSvg);
          const label = document.createElement('span');
          label.textContent = item.latestVendor
            ? `已点亮 ${item.count} 篇实测 · 查看 ${item.latestVendor} 测评`
            : `已点亮 ${item.count} 篇实测 · 查看实测报告`;
          a.append(label);
          statusEl.replaceChildren(a);
        } else {
          const span = document.createElement('span');
          span.className = 'subtle-label';
          span.textContent = '暂未收录实测样机 · 持续蹲守库存中';
          statusEl.replaceChildren(span);
        }
      }
    };

    zoneTabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        if (spinning) return;
        applyZoneFilter(tab.dataset.exoticZone || 'all');
        const pool = getVisibleIndices();
        if (pool.length && !pool.includes(current)) {
          selectTerritory(pool[0]);
        }
      });
    });

    stamps.forEach((btn, idx) => {
      btn.addEventListener('click', () => {
        if (!spinning) selectTerritory(idx);
      });
    });

    spinBtn?.addEventListener('click', () => {
      if (spinning) return;
      let pool = getVisibleIndices();
      if (pool.length <= 1 && data.length > 1) {
        applyZoneFilter('all');
        pool = getVisibleIndices();
      }
      if (pool.length <= 1) return;

      const reduced = window.matchMedia(
        '(prefers-reduced-motion: reduce)',
      ).matches;
      let next = pool[Math.floor(Math.random() * pool.length)];
      if (next === current) {
        next = pool[(pool.indexOf(current) + 1) % pool.length];
      }

      if (reduced) {
        selectTerritory(next, true);
        return;
      }

      spinning = true;
      let step = 0;
      const totalSteps = 8;
      const tick = () => {
        step++;
        if (step >= totalSteps) {
          spinning = false;
          selectTerritory(next, true);
          return;
        }
        const hop = pool[Math.floor(Math.random() * pool.length)];
        selectTerritory(hop);
        window.setTimeout(tick, 60 + step * 16);
      };
      tick();
    });
  }
</script>
