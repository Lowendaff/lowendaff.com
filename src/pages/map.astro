---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import Flag from '../components/Flag.astro';
import MapArticle from '../components/map/MapArticle.astro';
import { getPublishedPosts } from '../lib/posts';
import { buildReviewMap } from '../lib/review-map';
import { countryLabel } from '../lib/records';
import { serializeJsonLd } from '../lib/seo';
import '../styles/review-map.css';

const posts = await getPublishedPosts();
const { places } = buildReviewMap(posts);
const articleCount = posts.length;
const countries = new Set(places.map((place) => place.country).filter(Boolean));
const types = [
  { value: 'all', label: '全部' },
  { value: 'vps', label: 'VPS' },
  { value: 'dedicated', label: '独立服务器' },
];
---

<BaseLayout
  title="测评地图"
  active="map"
  noindex={!posts.length}
  description="沉浸式探索 LowEndAFF 测评过的全球城市，在无边框 3D 地球与地区列表之间双向联动查看实测记录。"
  breadcrumbs={[
    { name: '首页', path: '/' },
    { name: '测评地图', path: '/map/' },
  ]}
>
  <div class="atlas-bleed-wrap">
    <div class="shell atlas-page" data-review-map>
      <header class="atlas-heading">
        <div>
          <h1>测评地图</h1>
          <p>转动地球或点击右侧地区列表，双向联动查看当地服务器实测档案。</p>
        </div>
        <p class="atlas-coverage">
          <span data-map-place-count>{places.length}</span> 个城市{' '}
          <span aria-hidden="true">·</span>{' '}
          <span data-map-country-count>{countries.size}</span> 个国家或地区{' '}
          <span aria-hidden="true">·</span>{' '}
          <span data-map-article-count>{articleCount}</span> 条实测
        </p>
      </header>

      <div class="atlas-workspace">
        <section
          class="atlas-scene"
          aria-label="测评地区三维地球"
          data-globe-scene
        >
          <div class="atlas-globe-stage">
            <div class="atlas-viewport" data-globe-viewport></div>
            <div class="atlas-markers" data-globe-markers></div>

            <div class="atlas-loading" data-globe-status role="status">
              <Icon name="earth-2-line" size={32} />
              <p data-globe-status-text>
                启用 JavaScript 可探索 3D
                地球；右侧可直接浏览已测评地区与文章列表。
              </p>
              <button type="button" data-globe-retry hidden>
                重新加载
              </button>
            </div>
          </div>

          <div class="atlas-dock-bar">
            <div
              class="atlas-controls"
              data-globe-controls
              hidden
              aria-label="地球视角控制"
            >
              <button
                type="button"
                data-globe-zoom="out"
                aria-label="缩小地球"
                title="缩小"
              >
                <Icon name="minimize-line" size={16} />
              </button>
              <button
                type="button"
                data-globe-home
                aria-label="回到初始视角"
                title="回到初始视角"
              >
                <Icon name="earth-2-line" size={16} />
              </button>
              <button
                type="button"
                data-globe-zoom="in"
                aria-label="放大地球"
                title="放大"
              >
                <Icon name="add-line" size={16} />
              </button>
            </div>

            <p class="atlas-gesture" id="globe-instructions">
              <span class="atlas-desktop-hint">拖动旋转 · 滚轮缩放</span>
              <span class="atlas-touch-hint">单指旋转 · 双指缩放</span>
              <span class="sr-only">
                键盘方向键旋转，加减键缩放，Home 键回到初始视角；Tab
                键选择城市。
              </span>
            </p>

            <span
              class="atlas-coordinates"
              data-globe-coordinates
              aria-hidden="true"
            ></span>
          </div>
        </section>

        <aside class="atlas-sidebar" aria-label="已测评地区与文章列表">
          <div
            class="atlas-type-filter notion-view-tabs"
            data-map-filters
            role="group"
            aria-label="测评类型"
          >
            {types.map(({ value, label }) => (
              <button
                type="button"
                data-map-type={value}
                aria-pressed={value === 'all' ? 'true' : 'false'}
              >
                {label}
              </button>
            ))}
          </div>

          <div class="atlas-regions-panel">
            <div class="atlas-panel-header">
              <h2>
                <Icon name="location-line" size={15} />
                <span>已测评地区</span>
                <span class="atlas-panel-badge mono">{places.length}</span>
              </h2>
              <button
                type="button"
                class="atlas-clear-region"
                data-map-clear
                hidden
              >
                显示全部地区
              </button>
            </div>

            {places.length > 0 ? (
              <div
                class="atlas-region-list"
                role="group"
                aria-label="按城市联动定位"
              >
                {places.map((place) => (
                  <button
                    type="button"
                    class="atlas-region-item"
                    data-map-select={place.id}
                    data-city-label={place.city}
                    data-country-label={countryLabel(
                      place.country || 'unspecified',
                    )}
                    aria-pressed="false"
                  >
                    <Flag code={place.country} size={16} />
                    <span class="atlas-region-meta">
                      <strong>{place.city}</strong>
                      <small>
                        {countryLabel(place.country || 'unspecified')}
                      </small>
                    </span>
                    <span class="atlas-region-count mono" data-place-count>
                      {place.articles.length} 篇
                    </span>
                  </button>
                ))}
              </div>
            ) : (
              <p class="atlas-empty-inline">暂无已测评地区。</p>
            )}
          </div>

          <div class="atlas-articles-panel" data-map-articles-panel>
            <div class="atlas-panel-header">
              <h2 data-map-title>测评文章列表</h2>
              <span
                class="atlas-result-status"
                data-map-result-status
                role="status"
              >
                全部地区 · {articleCount} 条测评
              </span>
            </div>

            <div class="atlas-articles-scroll" data-map-articles-scroll>
              {places.map((place) => (
                <section
                  class="atlas-place-group"
                  data-map-place={place.id}
                  data-city-label={place.city}
                  data-country-label={countryLabel(
                    place.country || 'unspecified',
                  )}
                >
                  <div class="atlas-place-group-label">
                    <Flag code={place.country} size={13} />
                    <span>
                      {countryLabel(place.country || 'unspecified')} ·{' '}
                      {place.city}
                    </span>
                  </div>
                  <ul class="atlas-articles">
                    {place.articles.map((article) => (
                      <MapArticle article={article} />
                    ))}
                  </ul>
                </section>
              ))}

              <p class="atlas-empty" data-map-empty hidden={articleCount > 0}>
                暂无测试记录。
              </p>
            </div>

            <a class="atlas-all-records" href="/tags/">
              <span>在标签云按商家与地区组合检索</span>
              <Icon name="arrow-right-line" size={15} />
            </a>
          </div>
        </aside>
      </div>

      <p class="atlas-natural-earth">
        标记仅代表所在城市，不代表机房精确物理地址 · 地理轮廓数据来自{' '}
        <a
          href="https://www.naturalearthdata.com/"
          target="_blank"
          rel="noopener noreferrer"
        >
          Natural Earth
        </a>
      </p>

      <script
        type="application/json"
        data-map-data
        set:html={serializeJsonLd({ places })}
      />
    </div>
  </div>
</BaseLayout>
<script>
  import { initReviewMap } from '../scripts/review-map';
  initReviewMap();
</script>
