---
import { getPublishedPosts, postPath } from '../lib/posts';

// Static-host fallback. Configure HTTP 301 rules at the hosting layer too.
export async function getStaticPaths() {
  return (await getPublishedPosts())
    .filter(({ data }) => data.originalUrl)
    .map(({ data }) => ({
      params: {
        legacy: decodeURIComponent(new URL(data.originalUrl!).pathname).replace(
          /^\/|\/$/g,
          '',
        ),
      },
      props: { destination: postPath({ data }) },
    }));
}
return Astro.redirect(Astro.props.destination, 301);
---
