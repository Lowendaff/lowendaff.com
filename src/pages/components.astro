---
import BaseLayout from '../layouts/BaseLayout.astro';
import VpsSpecCard from '../components/mdx/VpsSpecCard.astro';
import BenchmarkTerminal from '../components/mdx/BenchmarkTerminal.astro';
import { getPublishedPosts } from '../lib/posts';
import RouteTraceTable from '../components/mdx/RouteTraceTable.astro';
import PromoCodeBox from '../components/mdx/PromoCodeBox.astro';
const posts = await getPublishedPosts();
const specPost = posts.find(({ data }) => data.showcase?.specs)?.data;
const terminal = posts.find(({ data }) => data.showcase?.terminal)?.data
  .showcase?.terminal;
const promo = posts.find(({ data }) => data.showcase?.promo)?.data;
const routePost = posts.find(({ data }) => data.showcase?.route)?.data;
const route = routePost?.showcase?.route;
const routeTable = routePost?.review?.sections
  .flatMap((section) => section.blocks)
  .find((block) => block.type === 'table' && block.id === route?.tableId);
const typography = specPost?.showcase?.typography || [];
const colors = [
  ['Canvas', 'canvas'],
  ['Surface', 'surface'],
  ['Text', 'text'],
  ['Muted', 'muted'],
  ['Accent', 'accent'],
  ['Accent soft', 'accent-soft'],
];
---

<BaseLayout title="组件展示" active="components" noindex>
  <div class="shell">
    <header class="kit-heading">
      <p class="eyebrow">LOWENDAFF</p>
      <h1>组件展示</h1>
    </header>
    <section class="kit-section">
      <h2>01　语义色彩</h2>
      <div class="token-grid">
        {colors.map(([label, token]) => (
          <div class="token-swatch panel">
            <div style={`background:var(--${token})`}></div>
            <strong>{label}</strong>
            <code>--{token}</code>
          </div>
        ))}
      </div>
    </section>
    <section class="kit-section kit-two">
      <div class="kit-type panel">
        <span class="eyebrow">排版</span>
        <h3>好服务器，用数据说话。</h3>
        <p>正文保持舒适行宽，标题与内容有清晰的层级。</p>
        <p class="mono">{typography.join('　')}</p>
      </div>
      <div class="kit-type panel">
        <span class="eyebrow">状态样式</span>
        <h3>状态不只依赖颜色。</h3>
        <p>
          <span class="state-chip success">● 正常</span>{' '}
          <span class="state-chip warning">▲ 波动</span>{' '}
          <span class="state-chip danger">× 异常</span>
        </p>
      </div>
    </section>
    <section class="kit-section">
      <h2>02　配置速览</h2>
      <VpsSpecCard specs={specPost?.specs || []} />
    </section>
    <section class="kit-section kit-two">
      <div>
        <h2>03　测试摘要</h2>
        {terminal && (
          <BenchmarkTerminal title={terminal.title} output={terminal.output} />
        )}
      </div>
      <div>
        <h2 style="margin-bottom:24px">04　优惠与购买</h2>
        {promo?.price && promo.purchaseUrl && (
          <PromoCodeBox
            price={promo.price}
            code={promo.coupon}
            href={promo.purchaseUrl}
            startingPrice={promo.startingPrice}
            affiliate={promo.affiliate}
            terms={promo.showcase?.promoTerms || promo.terms}
          />
        )}
      </div>
    </section>
    <section class="kit-section">
      <h2>05　回程路由</h2>
      {route && routeTable?.type === 'table' && (
        <RouteTraceTable
          headers={routeTable.headers}
          rows={routeTable.rows}
          target={route.target}
          protocol={route.protocol}
        />
      )}
    </section>
  </div>
</BaseLayout>
