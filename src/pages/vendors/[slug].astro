---
import TopicHubPage from '../../components/TopicHubPage.astro';
import { getPublishedPosts } from '../../lib/posts';
import { buildTopicHubs, type TopicHub } from '../../lib/topic-hubs';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const { vendorHubs, allHubs } = buildTopicHubs(posts);
  return vendorHubs.map((hub) => ({
    params: { slug: hub.slug },
    props: {
      hub,
      otherHubs: allHubs.filter((h) => h.path !== hub.path).slice(0, 8),
    },
  }));
}

interface Props {
  hub: TopicHub;
  otherHubs: TopicHub[];
}
const { hub, otherHubs } = Astro.props;
---

<TopicHubPage hub={hub} otherHubs={otherHubs} />
