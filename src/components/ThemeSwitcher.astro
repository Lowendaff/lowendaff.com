---
import Icon from './Icon.astro';
const options = [
  { value: 'system', label: '跟随系统', icon: 'monitor' },
  { value: 'light', label: '浅色', icon: 'sun' },
  { value: 'dark', label: '深色', icon: 'moon' },
];
---

<details class="theme-picker" hidden>
  <summary id="theme-toggle" aria-label="外观：跟随系统" title="外观：跟随系统">
    {options.map((option) => (
      <span data-theme-icon={option.value}>
        <Icon name={option.icon} />
      </span>
    ))}
  </summary>
  <div class="theme-options" role="group" aria-label="选择主题外观">
    {options.map((option) => (
      <button
        type="button"
        data-appearance-option={option.value}
        aria-pressed={option.value === 'system'}
      >
        <Icon name={option.icon} size={18} />
        <span>{option.label}</span>
        <span class="theme-check">
          <Icon name="check" size={16} />
        </span>
      </button>
    ))}
  </div>
</details>

<style>
  .theme-picker {
    position: relative;
  }
  .theme-picker summary {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-sm);
    list-style: none;
    color: var(--muted);
    transition: var(--transition-ui);
  }
  @media (max-width: 760px) {
    .theme-picker summary {
      width: var(--control-h-md);
      height: var(--control-h-md);
      border-radius: var(--radius-md);
    }
  }
  .theme-picker summary::-webkit-details-marker {
    display: none;
  }
  .theme-picker summary:hover,
  .theme-picker[open] summary {
    color: var(--text);
    background: var(--subtle);
  }
  [data-theme-icon] {
    display: none;
  }
  :global([data-appearance='system']) [data-theme-icon='system'],
  :global([data-appearance='light']) [data-theme-icon='light'],
  :global([data-appearance='dark']) [data-theme-icon='dark'] {
    display: flex;
  }
  .theme-options {
    position: absolute;
    right: 0;
    top: calc(100% + 8px);
    width: 184px;
    padding: 6px;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--raised);
    box-shadow: var(--shadow-md);
  }
  .theme-options button {
    width: 100%;
    min-height: 44px;
    padding: 8px 12px;
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 14px;
    font-weight: 500;
    text-align: left;
    background: transparent;
    color: var(--text);
    transition: var(--transition-ui);
  }
  .theme-options button:hover {
    background: var(--subtle);
  }
  .theme-options button[aria-pressed='true'] {
    color: var(--accent);
    background: var(--accent-soft);
  }
  .theme-check {
    display: flex;
    margin-left: auto;
    visibility: hidden;
  }
  [aria-pressed='true'] .theme-check {
    visibility: visible;
  }
  .theme-options button:focus-visible {
    outline-offset: -2px;
  }
</style>
