---
import logos from '@iconify-json/logos/icons.json';

interface Props {
  size?: number;
  class?: string;
}

const { size = 18, class: className } = Astro.props;
const telegram = logos.icons.telegram;
const uid = `tg-${Math.random().toString(36).slice(2, 9)}`;
const body = telegram.body.replaceAll('SVG6DaOZcwt', uid);
---

<svg
  class:list={['telegram-logo', className]}
  width={size}
  height={size}
  viewBox={`0 0 ${logos.width ?? 256} ${logos.height ?? 256}`}
  aria-hidden="true"
  focusable="false"
  set:html={body}
/>
