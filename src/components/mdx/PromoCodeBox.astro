---
import Icon from '../Icon.astro';
interface Props {
  code?: string;
  price: string;
  href: string;
  affiliate?: boolean;
  terms?: string;
  startingPrice?: boolean;
}
const {
  code,
  startingPrice = false,
  price,
  href,
  affiliate = false,
  terms,
} = Astro.props;
---

<section class="promo-card panel" data-component="PromoCodeBox">
  <div class="component-heading">
    <span>方案与优惠</span>
    <Icon name="external" size={18} />
  </div>
  <div class="promo-price">
    <b translate="no">{price}</b>
    <span>/ 月{startingPrice && '起'}</span>
  </div>
  {code && (
    <div class="coupon">
      <div>
        <small>优惠码</small>
        <strong translate="no">{code}</strong>
      </div>
      <button
        class="icon-button"
        data-copy={code}
        aria-label={`复制优惠码 ${code}`}
      >
        <Icon name="copy" size={18} />
      </button>
      <span class="copy-feedback" data-copy-status aria-live="polite"></span>
    </div>
  )}
  {terms && <p class="promo-terms">{terms}</p>}
  <a
    class="button primary full-width"
    href={href}
    target="_blank"
    rel={affiliate ? 'sponsored noopener noreferrer' : 'noopener noreferrer'}
  >
    查看套餐 <Icon name="external" size={17} />
  </a>
  <p class="disclosure">
    {affiliate
      ? '推广披露：通过此链接购买，我们可能获得佣金。'
      : '外部商家链接，优惠与购买条件以商家说明为准。'}
  </p>
</section>
