---
import type { Ad } from '../../lib/commercial';
import BrandMark from './BrandMark.astro';
import Icon from '../Icon.astro';
interface Props {
  ads: Ad[];
  placement: 'sidebar' | 'article-top' | 'article-bottom';
}
const { placement, ads } = Astro.props;
---

{ads.length > 0 && (
  <aside
    class:list={['commercial-slot', `commercial-${placement}`]}
    aria-label="广告"
    data-ad-slot={placement}
  >
    <div class="commercial-slot-header">
      <span>赞助商精选</span>
      <a href="/ads/">合作说明</a>
    </div>
    <div class="commercial-stack" data-ad-stack>
      {ads.map((ad) => (
        <a
          href={ad.url}
          target="_blank"
          rel="sponsored nofollow noopener noreferrer"
          class="commercial-creative brand-card"
          data-ad-brand={ad.name}
          aria-label={`${ad.name}：了解产品`}
        >
          <div class="brand-card-top">
            <BrandMark name={ad.name} logo={ad.logo} logoDark={ad.logoDark} />
            <span class="brand-visit-chip" aria-hidden="true">
              <Icon name="arrow-right-up-line" size={14} />
            </span>
          </div>

          <div class="brand-card-body creative-copy">
            <strong>{ad.title}</strong>
            <p>{ad.description}</p>
            {ad.tags.length > 0 && (
              <ul class="partner-tags">
                {ad.tags.slice(0, 3).map((tag) => (
                  <li translate="no">{tag}</li>
                ))}
              </ul>
            )}
          </div>
        </a>
      ))}
    </div>
  </aside>
)}
