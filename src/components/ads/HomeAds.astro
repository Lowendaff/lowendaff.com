---
import { getAds } from '../../lib/commercial';
import BrandMark from './BrandMark.astro';
import Icon from '../Icon.astro';
const products = await getAds('homeFeaturedAds');
---

{products.length > 0 && (
  <section class="sponsor-products" aria-labelledby="products-title">
    <div class="partner-board-header">
      <div class="partner-board-title">
        <Icon name="star-line" size={16} />
        <h2 id="products-title">赞助商精选</h2>
      </div>
      <a class="partner-board-cta" href="/ads/">
        赞助合作 <Icon name="right-line" size={14} />
      </a>
    </div>
    <div class="partner-board-grid" data-home-ads>
      {products.map((product) => (
        <a
          href={product.url}
          data-product-brand={product.name}
          class="partner-card brand-card"
          target="_blank"
          rel="sponsored nofollow noopener noreferrer"
        >
          <div class="brand-card-top">
            <BrandMark
              name={product.name}
              logo={product.logo}
              logoDark={product.logoDark}
            />
            <span class="brand-visit-chip" aria-hidden="true">
              <Icon name="arrow-right-up-line" size={14} />
            </span>
          </div>

          <div class="brand-card-body">
            <h3>{product.title}</h3>
            <p>{product.description}</p>
            {product.tags.length > 0 && (
              <ul class="partner-tags">
                {product.tags.map((tag) => (
                  <li translate="no">{tag}</li>
                ))}
              </ul>
            )}
          </div>
        </a>
      ))}
    </div>
  </section>
)}
<script>
  // Shuffle sponsor cards once on load so every partner gets equal first-row visibility.
  document.querySelectorAll<HTMLElement>('[data-home-ads]').forEach((grid) => {
    const cards = Array.from(grid.children);
    for (let i = cards.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [cards[i], cards[j]] = [cards[j], cards[i]];
    }
    grid.append(...cards);
  });
</script>
