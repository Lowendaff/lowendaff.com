---
import type { MapArticle } from '../../lib/review-map';
import { reviewTypeLabels } from '../../lib/review-types';
import Icon from '../Icon.astro';
interface Props {
  article: MapArticle;
}
const { article } = Astro.props;
const dateFormat = new Intl.DateTimeFormat('zh-CN', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
  timeZone: 'UTC',
});
---

<li
  class="atlas-article"
  data-map-article
  data-review-type={article.reviewType}
>
  <a href={article.href}>
    <div class="atlas-article-meta">
      <span translate="no">{article.vendor}</span>
      <span>{reviewTypeLabels[article.reviewType]}</span>
    </div>
    <h3>{article.title.replace(/^(?:\p{Regional_Indicator}{2}\s*)+/u, '')}</h3>
    <div class="atlas-article-bottom">
      <time datetime={article.date}>
        {dateFormat.format(new Date(`${article.date}T00:00:00Z`))}
      </time>
      <span>
        阅读测评 <Icon name="arrow" size={16} />
      </span>
    </div>
  </a>
</li>
