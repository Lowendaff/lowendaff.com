---
import Icon from '../Icon.astro';
interface Props {
  id: string;
  label: string;
  text: string;
}
const { id, label, text } = Astro.props;
---

<div class="hint-heading" data-heading-hint>
  <h2>
    <button
      type="button"
      class="heading-hint-trigger"
      aria-describedby={id}
      data-hint-trigger
    >
      {label}
      <span aria-hidden="true">
        <Icon name="information-line" size={16} />
      </span>
    </button>
  </h2>
  <div class="heading-tooltip" id={id} role="tooltip" data-hint-content hidden>
    {text}
  </div>
</div>
