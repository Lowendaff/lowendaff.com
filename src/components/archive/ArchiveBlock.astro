---
import BenchmarkResultsTable from '../mdx/BenchmarkResultsTable.astro';
import BenchmarkTerminal from '../mdx/BenchmarkTerminal.astro';
import BilibiliVideo from '../mdx/BilibiliVideo.astro';
import VmCpuTelemetryChart from '../mdx/VmCpuTelemetryChart.astro';
import Icon from '../Icon.astro';
import type { ReviewBlock } from '../../lib/review-model';
interface Props {
  block: ReviewBlock;
  sectionTitle: string;
}
const { block, sectionTitle } = Astro.props;
const asset = block.asset;
const local =
  asset?.local ??
  (block.src?.startsWith('/archive-assets/') ? block.src : undefined);
---

{block.type === 'bilibili' && block.src && (
  <BilibiliVideo src={block.src} title={block.text} />
)}
{block.type === 'table' && (
  <div data-source-table={block.id}>
    <BenchmarkResultsTable
      headers={block.headers || []}
      rows={block.rows || []}
      links={block.links}
      caption={block.headings?.at(-1) || sectionTitle}
    />
  </div>
)}
{block.type === 'paragraph' && (
  <div class="archive-prose" set:html={`<p>${block.html}</p>`} />
)}
{block.type === 'quote' && (
  <blockquote class="archive-quote" set:html={block.html} />
)}
{block.type === 'code' &&
  (block.language === 'vm-cpu-telemetry' ? (
    <VmCpuTelemetryChart
      id={block.id ?? 'vm-telemetry'}
      payload={block.text ?? '{}'}
    />
  ) : (
    <div id={block.id}>
      <BenchmarkTerminal
        output={block.text ?? ''}
        title={block.headings?.at(-1) || sectionTitle}
        format="raw"
      />
    </div>
  ))}
{block.type === 'heading' &&
  (block.level === 3 ? (
    <h3 class="archive-subheading">{block.text}</h3>
  ) : (
    <h4 class="archive-subheading small">{block.text}</h4>
  ))}
{block.type === 'image' && (
  <figure class="archive-image">
    {local ? (
      <a href={local} target="_blank" aria-label="打开原图查看">
        <img
          src={local}
          alt={block.alt?.endsWith('.png') ? '原作者测评配图' : block.alt}
          loading="lazy"
          width={asset?.width}
          height={asset?.height}
          decoding="async"
        />
      </a>
    ) : (
      <div class="unavailable-image">
        <strong>
          {block.alt?.includes('BGP') ? 'BGP 透视图暂不可用' : '图片暂不可用'}
        </strong>
        <a href={block.src} target="_blank" rel="noopener noreferrer">
          查看图片 <Icon name="external-link-line" size={14} />
        </a>
      </div>
    )}
    {local && (
      <figcaption>
        {sectionTitle === 'BGP 透视'
          ? 'BGP 透视'
          : block.alt &&
              !/\.(?:png|jpe?g|webp|avif|gif|svg)$/i.test(block.alt) &&
              block.alt !== '原作者测评配图'
            ? `${block.alt} · 点击查看原图`
            : '测评配图 · 点击查看原图'}
      </figcaption>
    )}
  </figure>
)}
