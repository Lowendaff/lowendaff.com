---
interface Props {
  id: string;
  label: string;
  options: string[];
  group: number;
}
const { id, label, options, group } = Astro.props;
---

<div class="route-picker" data-route-picker={group} data-value="0" hidden>
  <span class="sr-only" id={`${id}-label`}>
    {label}
  </span>
  <button
    type="button"
    class="route-picker-trigger"
    role="combobox"
    aria-expanded="false"
    aria-haspopup="listbox"
    aria-controls={`${id}-listbox`}
    aria-labelledby={`${id}-label ${id}-value`}
    data-picker-trigger
  >
    <span id={`${id}-value`} data-picker-value>
      {options[0]}
    </span>
    <svg
      width="16"
      height="16"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      aria-hidden="true"
    >
      <path d="m6 9 6 6 6-6" />
    </svg>
  </button>
  <div
    class="route-picker-list"
    id={`${id}-listbox`}
    role="listbox"
    aria-labelledby={`${id}-label`}
    data-picker-list
    hidden
  >
    {options.map((option, index) => (
      <div
        class="route-picker-option"
        role="option"
        id={`${id}-option-${index}`}
        aria-selected={index === 0 ? 'true' : 'false'}
        data-picker-option={index}
      >
        <span>{option}</span>
        <span class="option-check" aria-hidden="true">
          ✓
        </span>
      </div>
    ))}
  </div>
</div>
<script>
  document
    .querySelectorAll<HTMLElement>('[data-route-picker]')
    .forEach((root) => {
      const trigger = root.querySelector<HTMLButtonElement>(
        '[data-picker-trigger]',
      )!;
      const value = root.querySelector<HTMLElement>('[data-picker-value]')!;
      const list = root.querySelector<HTMLElement>('[data-picker-list]')!;
      const options = Array.from(
        list.querySelectorAll<HTMLElement>('[data-picker-option]'),
      );
      let active = 0;
      let buffer = '';
      let typedAt = 0;
      const selected = () => Number(root.dataset.value || 0);
      const reflect = () => {
        const index = selected();
        value.textContent = options[index].querySelector('span')!.textContent;
        options.forEach((option, i) => {
          option.setAttribute('aria-selected', String(i === index));
        });
      };
      const highlight = (index: number) => {
        active = Math.min(options.length - 1, Math.max(0, index));
        options.forEach((option, i) => {
          option.dataset.active = String(i === active);
        });
        trigger.setAttribute('aria-activedescendant', options[active].id);
        options[active].scrollIntoView({ block: 'nearest' });
      };
      const close = () => {
        list.hidden = true;
        trigger.setAttribute('aria-expanded', 'false');
        trigger.removeAttribute('aria-activedescendant');
        buffer = '';
      };
      const commit = (index: number) => {
        root.dataset.value = String(index);
        reflect();
        close();
        root.dispatchEvent(
          new CustomEvent('route-select', { bubbles: true, detail: index }),
        );
      };
      const open = () => {
        document
          .querySelectorAll<HTMLElement>('[data-route-picker]')
          .forEach((other) => {
            if (other !== root)
              other.dispatchEvent(new Event('route-picker-close'));
          });
        // Measure once on opening; cap the floating list to the available viewport.
        const rect = trigger.getBoundingClientRect();
        const below = innerHeight - rect.bottom - 16;
        const above = rect.top - 100;
        const up = below < 220 && above > below;
        root.dataset.side = up ? 'top' : 'bottom';
        list.style.maxHeight = `${Math.max(88, Math.min(320, up ? above : below))}px`;
        list.hidden = false;
        trigger.setAttribute('aria-expanded', 'true');
        highlight(selected());
      };
      trigger.addEventListener('click', () => {
        list.hidden ? open() : close();
      });
      trigger.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') {
          if (!list.hidden) {
            event.preventDefault();
            close();
          }
          return;
        }
        if (event.key === 'Tab') {
          if (!list.hidden) commit(active);
          return;
        }
        if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          list.hidden ? open() : commit(active);
          return;
        }
        if (['ArrowDown', 'ArrowUp', 'Home', 'End'].includes(event.key)) {
          event.preventDefault();
          if (list.hidden) {
            open();
            if (event.key === 'Home') highlight(0);
            if (event.key === 'End') highlight(options.length - 1);
          } else
            highlight(
              event.key === 'Home'
                ? 0
                : event.key === 'End'
                  ? options.length - 1
                  : active + (event.key === 'ArrowDown' ? 1 : -1),
            );
          return;
        }
        if (
          event.key.length === 1 &&
          !event.ctrlKey &&
          !event.metaKey &&
          !event.altKey
        ) {
          event.preventDefault();
          if (list.hidden) open();
          const now = Date.now();
          buffer = now - typedAt > 700 ? event.key : buffer + event.key;
          typedAt = now;
          const needle = [...buffer].every((c) => c === buffer[0])
            ? buffer[0]
            : buffer;
          const match = options
            .map((_, i) => (active + i + 1) % options.length)
            .find((i) =>
              options[i]
                .textContent!.trim()
                .toLocaleLowerCase()
                .startsWith(needle.toLocaleLowerCase()),
            );
          if (match !== undefined) highlight(match);
        }
      });
      options.forEach((option, i) => {
        option.addEventListener('pointerdown', (event) =>
          event.preventDefault(),
        );
        option.addEventListener('click', () => {
          commit(i);
          trigger.focus({ preventScroll: true });
        });
        option.addEventListener('pointermove', (event) => {
          if (event.pointerType === 'mouse' && active !== i) highlight(i);
        });
      });
      document.addEventListener('pointerdown', (event) => {
        if (!root.contains(event.target as Node)) close();
      });
      root.addEventListener('focusout', () => {
        queueMicrotask(() => {
          if (!root.contains(document.activeElement)) close();
        });
      });
      root.addEventListener('route-picker-close', close);
      root.addEventListener('route-picker-sync', reflect);
      root.hidden = false;
      reflect();
    });
</script>
