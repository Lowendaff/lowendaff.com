---
import RouteSelect from './RouteSelect.astro';
import BenchmarkResultsTable from '../mdx/BenchmarkResultsTable.astro';
import ArchiveBlock from './ArchiveBlock.astro';
interface Block {
  type: string;
  id?: string;
  line: number;
  headings?: string[];
  headers?: string[];
  rows?: string[][];
  html?: string;
  text?: string;
}
interface Props {
  blocks: Block[];
  id: string;
  inbound?: boolean;
}
const { blocks, id, inbound = false } = Astro.props;
const tables = blocks.filter((b) => b.type === 'table' || b.type === 'code');
const sectionNotes = blocks.filter(
  (b, i) =>
    b.type === 'paragraph' && !['table', 'code'].includes(blocks[i + 1]?.type),
);
const groupFor = (b: Block) => {
  const h = b.headings || [];
  const title = h.at(-1) || '';
  if (inbound) return h[0] || '其他';
  if (h[0] === '中国境内目标')
    return title.includes('电信')
      ? '中国电信'
      : title.includes('联通')
        ? '中国联通'
        : '中国移动';
  return h[0] === '主要公共服务' ? '公共服务' : '国际网络';
};
const groupNames = [...new Set(tables.map(groupFor))].sort(
  (a, b) =>
    ['中国电信', '中国联通', '中国移动', '公共服务', '国际网络'].indexOf(a) -
    ['中国电信', '中国联通', '中国移动', '公共服务', '国际网络'].indexOf(b),
);
const groups = groupNames.map((name) => ({
  name,
  tables: tables.filter((b) => groupFor(b) === name),
}));
---

<div class="route-explorer" data-route-explorer={id}>
  {sectionNotes.map((note) => (
    <p class="route-origin" set:html={note.html} />
  ))}
  <div class="route-toolbar">
    <div
      class="route-tabs"
      role="tablist"
      aria-label={inbound ? '去程来源' : '回程运营商'}
    >
      {groups.map((group, i) => (
        <button
          type="button"
          role="tab"
          id={`${id}-tab-${i}`}
          aria-controls={`${id}-panel-${i}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          tabindex={i === 0 ? 0 : -1}
          data-route-tab={i}
        >
          {group.name}
          <span>{group.tables.length}</span>
        </button>
      ))}
    </div>
  </div>
  {groups.map((group, i) => (
    <section
      id={`${id}-panel-${i}`}
      role="tabpanel"
      aria-labelledby={`${id}-tab-${i}`}
      data-route-panel={i}
      tabindex="0"
    >
      <RouteSelect
        id={`${id}-select-${i}`}
        label={inbound ? '来源节点' : '城市与线路'}
        options={group.tables.map(
          (table) => table.headings?.at(-1) || '未命名节点',
        )}
        group={i}
      />
      {group.tables.map((table, j) => {
        const index = blocks.indexOf(table);
        const note =
          blocks[index - 1]?.type === 'paragraph'
            ? blocks[index - 1].html
            : undefined;
        return (
          <div data-route-record={j} data-source-table={table.id}>
            <h4 class="route-record-title">{table.headings?.at(-1)}</h4>
            {note && <p class="route-origin" set:html={note} />}
            {table.type === 'code' ? (
              <ArchiveBlock block={table} sectionTitle="路由测试" />
            ) : (
              <div class="route-table-frame" data-route-table>
                <BenchmarkResultsTable
                  headers={table.headers || []}
                  rows={table.rows || []}
                  caption={table.headings?.at(-1) || '路由测试'}
                />
                <span class="scroll-edge scroll-edge-left" aria-hidden="true" />
                <span
                  class="scroll-edge scroll-edge-right"
                  aria-hidden="true"
                />
                <span class="scroll-edge scroll-edge-top" aria-hidden="true" />
                <span
                  class="scroll-edge scroll-edge-bottom"
                  aria-hidden="true"
                />
              </div>
            )}
          </div>
        );
      })}
    </section>
  ))}
</div>
<script>
  document
    .querySelectorAll<HTMLElement>('[data-route-explorer]')
    .forEach((root) => {
      const tabs = Array.from(
        root.querySelectorAll<HTMLButtonElement>('[data-route-tab]'),
      );
      const panels = Array.from(
        root.querySelectorAll<HTMLElement>('[data-route-panel]'),
      );
      const selectors = Array.from(
        root.querySelectorAll<HTMLElement>('[data-route-picker]'),
      );
      if (!tabs.length) return;
      let selected = 0;
      const key = root.dataset.routeExplorer || 'routes';
      const restore = () => {
        const initial = new URLSearchParams(location.search)
          .get(key)
          ?.split(':');
        if (!initial) return;
        const group = Number(initial[0]);
        selected =
          Number.isInteger(group) && group >= 0 && group < tabs.length
            ? group
            : 0;
        const target = Number(initial[1]);
        const count = selectors[selected].querySelectorAll(
          '[data-picker-option]',
        ).length;
        selectors[selected].dataset.value = String(
          Number.isInteger(target) && target >= 0 && target < count
            ? target
            : 0,
        );
      };
      const render = (sync = true) => {
        tabs.forEach((tab, i) => {
          tab.setAttribute('aria-selected', String(i === selected));
          tab.tabIndex = i === selected ? 0 : -1;
        });
        panels.forEach((panel, i) => {
          panel.hidden = i !== selected;
          selectors[i].dispatchEvent(new Event('route-picker-close'));
          selectors[i].dispatchEvent(new Event('route-picker-sync'));
          panel
            .querySelectorAll<HTMLElement>('[data-route-record]')
            .forEach((record) => {
              record.hidden =
                record.dataset.routeRecord !== selectors[i].dataset.value;
            });
        });
        if (sync) {
          const url = new URL(location.href);
          url.searchParams.set(
            key,
            `${selected}:${selectors[selected].dataset.value}`,
          );
          history.replaceState(null, '', url);
        }
      };
      tabs.forEach((tab, i) => {
        tab.addEventListener('click', () => {
          selected = i;
          render();
        });
        tab.addEventListener('keydown', (event) => {
          const next =
            event.key === 'ArrowRight'
              ? (i + 1) % tabs.length
              : event.key === 'ArrowLeft'
                ? (i - 1 + tabs.length) % tabs.length
                : event.key === 'Home'
                  ? 0
                  : event.key === 'End'
                    ? tabs.length - 1
                    : -1;
          if (next < 0) return;
          event.preventDefault();
          selected = next;
          render();
          tabs[next].focus();
        });
      });
      selectors.forEach((select) =>
        select.addEventListener('route-select', () => render()),
      );
      root.classList.add('enhanced');
      restore();
      render(false);

      // Hidden route records are measured again when their panel becomes visible.
      const scrollFrames = new Map<HTMLElement, HTMLElement>();
      const pending = new Set<HTMLElement>();
      let frameRequest = 0;
      const measure = () => {
        frameRequest = 0;
        pending.forEach((viewport) => {
          const frame = scrollFrames.get(viewport)!;
          const visible = viewport.clientWidth > 0 && viewport.clientHeight > 0;
          frame.dataset.scrollLeft = String(visible && viewport.scrollLeft > 1);
          frame.dataset.scrollRight = String(
            visible &&
              viewport.scrollWidth -
                viewport.clientWidth -
                viewport.scrollLeft >
                1,
          );
          frame.dataset.scrollUp = String(visible && viewport.scrollTop > 1);
          frame.dataset.scrollDown = String(
            visible &&
              viewport.scrollHeight -
                viewport.clientHeight -
                viewport.scrollTop >
                1,
          );
          if (visible) {
            frame.style.setProperty(
              '--route-header-height',
              `${viewport.querySelector('thead')?.getBoundingClientRect().height ?? 0}px`,
            );
          }
        });
        pending.clear();
      };
      const schedule = (viewport: HTMLElement) => {
        pending.add(viewport);
        if (!frameRequest) frameRequest = requestAnimationFrame(measure);
      };
      const resizeObserver = new ResizeObserver((entries) => {
        entries.forEach(({ target }) => {
          const viewport = target.matches('.data-table')
            ? (target as HTMLElement)
            : target.closest<HTMLElement>('.data-table');
          if (viewport) schedule(viewport);
        });
      });
      root
        .querySelectorAll<HTMLElement>('[data-route-table]')
        .forEach((frame) => {
          const viewport = frame.querySelector<HTMLElement>('.data-table')!;
          scrollFrames.set(viewport, frame);
          viewport.addEventListener('scroll', () => schedule(viewport), {
            passive: true,
          });
          resizeObserver.observe(viewport);
          resizeObserver.observe(viewport.querySelector('table')!);
          schedule(viewport);
        });
    });
</script>
