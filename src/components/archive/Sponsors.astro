---
import Icon from '../Icon.astro';
import BrandMark from '../ads/BrandMark.astro';
import { getSponsors } from '../../lib/commercial';

const sponsors = await getSponsors('article-sidebar');
// Owned, static SVG wordmarks validated at build time. Never inline untrusted remote SVG markup.
const marks = import.meta.glob('../../assets/sponsors/*.svg', {
  eager: true,
  query: '?raw',
  import: 'default',
}) as Record<string, string>;
for (const sponsor of sponsors) {
  if (!marks[`../../assets/sponsors/${sponsor.logo}`])
    throw new Error(`Missing sponsor SVG: ${sponsor.logo}`);
}
---

{sponsors.length > 0 && (
  <section class="sponsor-wall" aria-labelledby="sponsor-title">
    <div class="sponsor-wall-head">
      <Icon name="star-line" size={14} />
      <h2 id="sponsor-title">基础设施赞助名录</h2>
      <span class="sponsor-wall-count mono">{sponsors.length}</span>
    </div>
    <div class="sponsor-grid" data-sponsor-grid>
      {sponsors.map((s) => (
        <a
          href={s.url}
          target="_blank"
          rel="sponsored nofollow noopener noreferrer"
          data-sponsor-name={s.name}
          aria-label={`${s.name} 赞助商网站`}
        >
          <span class="sponsor-mark" translate="no">
            <span class="sponsor-logo-well">
              <BrandMark
                name={s.name}
                logo={s.brandLogo}
                logoDark={s.brandLogoDark}
                size="dir"
              />
            </span>
            <span class="sponsor-tile-name">{s.name}</span>
          </span>
        </a>
      ))}
    </div>
  </section>
)}
