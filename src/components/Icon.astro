---
import mingcute from '@iconify-json/mingcute/icons.json';

interface Props {
  name?: string;
  size?: number;
  class?: string;
}

const { name = 'arrow', size = 18, class: className } = Astro.props;

const aliases: Record<string, string> = {
  arrow: 'arrow-right-line',
  'arrow-left': 'arrow-left-line',
  left: 'left-line',
  right: 'right-line',
  down: 'down-line',
  up: 'up-line',
  plus: 'add-line',
  minus: 'minimize-line',
  external: 'external-link-line',
  'arrow-up-right': 'arrow-right-up-line',
  search: 'search-line',
  monitor: 'computer-line',
  moon: 'moon-line',
  sun: 'sun-line',
  copy: 'copy-2-line',
  clock: 'time-line',
  globe: 'earth-2-line',
  chip: 'chip-line',
  route: 'route-line',
  chevron: 'down-line',
  'chevron-right': 'right-line',
  check: 'check-line',
  rss: 'rss-2-line',
  menu: 'menu-line',
  close: 'close-line',
  send: 'telegram-line',
  shield: 'shield-line',
  info: 'information-line',
  book: 'book-2-line',
  document: 'document-line',
  quill: 'quill-pen-line',
  location: 'location-line',
  calendar: 'calendar-line',
  tag: 'tag-line',
  terminal: 'terminal-box-line',
  compass: 'compass-line',
  link: 'link-line',
  server: 'server-line',
  'server-dedicated': 'server-2-line',
  cloud: 'cloud-line',
  grid: 'layout-grid-line',
  user: 'user-3-line',
  bag: 'shopping-bag-2-line',
  dashboard: 'dashboard-2-line',
  unlock: 'unlock-line',
  transfer: 'transfer-3-line',
  building: 'building-2-line',
  star: 'star-line',
  filter: 'filter-line',
  refresh: 'refresh-2-line',
  'home-slot': 'home-4-line',
  'top-slot': 'layout-top-line',
  'side-slot': 'layout-right-line',
  'bottom-slot': 'layout-bottom-line',
};

const iconKey = aliases[name] ?? name;
if (!iconKey.endsWith('-line')) {
  throw new Error(`Icon "${iconKey}" must be a Mingcute Line (*-line) icon.`);
}
const icon = (mingcute.icons as Record<string, { body: string }>)[iconKey];
if (!icon) {
  throw new Error(`Missing Mingcute Line icon: "${iconKey}"`);
}
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox={`0 0 ${mingcute.width ?? 24} ${mingcute.height ?? 24}`}
  aria-hidden="true"
  focusable="false"
  set:html={icon.body}
/>
