---
import Icon from './Icon.astro';
import { reviewTypes, reviewTypeLabels } from '../lib/review-types';
const iconFor: Record<string, string> = {
  '': 'layout-grid-line',
  vps: 'cloud-line',
  dedicated: 'server-2-line',
};
const options = [
  { value: '', label: '全部' },
  ...reviewTypes.map((value) => ({ value, label: reviewTypeLabels[value] })),
];
---

<div
  class="review-type-filter notion-view-tabs"
  role="group"
  aria-label="测评类型"
  data-type-filter
  hidden
>
  {options.map(({ value, label }) => (
    <button
      type="button"
      data-review-type={value}
      aria-pressed={value === '' ? 'true' : 'false'}
      aria-controls="reviews"
      translate="no"
    >
      <Icon name={iconFor[value] ?? 'server-line'} size={15} />
      <span>{label}</span>
    </button>
  ))}
</div>
